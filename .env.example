# DemoDay Backend Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here
FAL_KEY=your_fal_ai_api_key_here
# Optional: fal.ai text-to-video model for the AI intro/outro (default Seedance 1.0 Pro Fast, 1080p)
FAL_VIDEO_MODEL=fal-ai/bytedance/seedance/v1/pro/fast/text-to-video
PORT=8000
STORAGE_DIR=storage
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Encrypts users' saved GitHub tokens and app logins (32 random bytes, base64). run.sh generates one.
# Keep it secret and stable: changing it makes every saved credential unreadable.
DEMODAY_SECRET_KEY=

# Optional: require this code to create an account (recommended for a hosted demo).
SIGNUP_CODE=
# Set to true when serving the dashboard over HTTPS (hosted), so session cookies are Secure.
COOKIE_SECURE=false
# Local development only: allow recording apps on localhost or private networks. Never enable on a hosted server.
ALLOW_PRIVATE_URLS=false
# Optional server-wide GitHub token, used when a user hasn't saved their own.
GITHUB_TOKEN=

# --- Production / Cloud Run (set by deploy.sh) ---
# Static dashboard export served from "/" when the directory exists (same origin as the API).
STATIC_DIR=static
# SQLite lives at DB_PATH (local disk); DB_BACKUP_PATH keeps a copy on the mounted bucket (restored on start).
DB_PATH=
DB_BACKUP_PATH=
# Bucket mounted at STORAGE_DIR; optional public bucket for share links (see ./deploy.sh --enable-share-links).
GCS_BUCKET=
GCS_PUBLIC_BUCKET=
# Google Cloud Text-to-Speech (Chirp 3 HD) as the narration fallback after fal.ai; uses runtime credentials.
GOOGLE_TTS=false
